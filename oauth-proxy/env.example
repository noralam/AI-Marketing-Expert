# OAuth Proxy Environment Variables
# Copy to .env and fill in your credentials

# Server
PORT=3000
NODE_ENV=production

# The public URL of this proxy server's callback endpoint.
# Must match EXACTLY what's configured in Facebook Developer Console.
CALLBACK_URL=https://oauth.wpthemespace.com/v1/callback

# Facebook / Instagram (both use the same Facebook App)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
